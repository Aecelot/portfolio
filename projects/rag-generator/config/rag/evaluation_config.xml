      <domain_match_rate>0.90</domain_match_rate>
    </side_characters_3>
    <organizations_factions>
      <recall_at_5>0.80</recall_at_5>
      <entity_hit_rate>0.88</entity_hit_rate>
      <domain_match_rate>0.85</domain_match_rate>
    </organizations_factions>
    <politics_governance>
