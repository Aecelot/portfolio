  <alert_thresholds>
    <critical_failure_rate>0.10</critical_failure_rate>
    <performance_regression>-0.05</performance_regression>
    <latency_spike>2.0</latency_spike>
  </alert_thresholds>

  <!-- FAISS-specific KPI targets -->
  <faiss_kpis>
    <accuracy_targets>
      <overlap_at_10>&gt;= 0.90</overlap_at_10>
      <recall_at_5>&gt;= 0.80</recall_at_5>
      <mean_reciprocal_rank>&gt;= 0.70</mean_reciprocal_rank>
      <description>Accuracy targets for ANN vs exact baseline comparison</description>
    </accuracy_targets>

    <performance_targets>
      <query_latency_p95_ms>&lt;= 150</query_latency_p95_ms>
      <throughput_qps>&gt;= 100</throughput_qps>
      <description>Performance targets for search operations</description>
    </performance_targets>

    <resource_targets>
      <memory_efficiency_mb_per_vector>&lt;= 0.01</memory_efficiency_mb_per_vector>
      <build_time_per_1000_vectors>&lt;= 5.0</build_time_per_1000_vectors>
      <description>Resource efficiency targets</description>
    </resource_targets>

    <integrity_targets>
      <sha256_hash>enabled</sha256_hash>
      <dimensionality_check>enabled</dimensionality_check>
      <normalization_check>enabled</normalization_check>
      <description>Data integrity verification requirements</description>
    </integrity_targets>
  </faiss_kpis>

  <!-- Parameter sweep configurations for FAISS optimization -->
  <parameter_sweeps>
    <hnsw_sweep>
      <M>16,32,64</M>
      <efSearch>32,64,96,128</efSearch>
      <efConstruction>200</efConstruction>
      <description>HNSW parameter combinations to test for optimal recall-latency tradeoff</description>
    </hnsw_sweep>

    <ivf_sweep>
      <nlist>sqrt(N),sqrt(N)*2,sqrt(N)*4</nlist>
      <nprobe>8,16,32,64</nprobe>
      <description>IVF parameter combinations for clustering-based search optimization</description>
    </ivf_sweep>

    <evaluation_config>
      <sample_size>200</sample_size>
      <random_seed>42</random_seed>
      <plots_directory>evaluation_plots/</plots_directory>
      <description>Configuration for parameter sweep evaluation</description>
    </evaluation_config>
  </parameter_sweeps>


  <instructions><![CDATA[
HOW TO RUN EVALUATION:

1. SETUP:
   - Ensure your RAG system is running with /retrieve endpoint active
   - Verify config/rag.yaml and config/api.yaml are properly configured
   - Check that data/gold_queries.json exists and is valid

2. BASIC EVALUATION:
   python -m evaluation.harness --config config/evaluation_config.xml

3. METRIC CALCULATIONS:
   - Recall@K: For each query, check if any gold_section appears in top-K results
   - MRR@5: For each query, find rank of first gold_section, compute 1/rank, average
   - Entity hit-rate: Count queries where retrieved sections share entities with gold query
   - Domain match: Compare domain metadata between query and top-1 result

4. PERFORMANCE TRACKING:
   - Use timing decorators on /retrieve endpoint
   - Track embedding, ANN search, reranking, and graph boost times separately
   - Monitor token usage vs budget

5. ABLATION STUDIES:
   - Run with reranker disabled to measure gain
   - Run with graph boost disabled to measure contribution
   - Compare results to establish baseline performance

6. CONTINUOUS MONITORING:
   - Set up daily evaluation runs on a subset of queries
   - Track performance trends over time
   - Alert on significant regressions
]]></instructions>

  <expected_outputs>
