# Ryzen AI 300 Series - Optimized Configuration for LLM Server
# Framework 13 Laptop: AMD Ryzen AI 9 HX 370 + Radeon 890M Graphics (RDNA 3.5)

# Server Configuration
LLM_HOST=127.0.0.1
LLM_PORT=5001

# Model Configuration
LLM_MODEL_PATH=models/Llama-3.2-1B-Instruct-Q4_K_M.gguf

# Ryzen AI 300 Optimized Performance Settings
LLM_THREADS=12
LLM_CTX=8192
LLM_GPULAYERS=45

# AMD GPU Acceleration (RDNA 3.5 iGPU) - Core flags only
LLM_USECLBLAST=1
LLM_CLBLAST_PLATFORM=0
LLM_CLBLAST_DEVICE=0

# Memory Optimizations (widely supported)
LLM_USEMMAP=1
LLM_USEMLock=1

# Advanced Performance Settings
LLM_NO_KV_OFFLOAD=0
LLM_BATCH_SIZE=1024
LLM_UBATCH_SIZE=512
LLM_FLASH_ATTENTION=1

# Multi-slot inference (2 slots for iGPU with shared memory)
LLM_PARALLEL_SLOTS=2
LLM_CONT_BATCHING=1