<?xml version="1.0" encoding="UTF-8"?>
<evaluation>
  <name>Lore RAG Retrieval Quality Assessment</name>
  <version>1.0</version>
  <description>Comprehensive evaluation of RAG retrieval performance using curated gold queries</description>
  <gold_queries_path>data/gold_queries.json</gold_queries_path>
  <retriever_endpoint>/retrieve</retriever_endpoint>
  <test_environment>development</test_environment>

  <metrics>
    <recall_at_k>
      <k value="1">
        <target>&gt;= 0.70</target>
        <description>Did any gold passage appear in top 1 result?</description>
      </k>
      <k value="3">
        <target>&gt;= 0.75</target>
        <description>Did any gold passage appear in top 3 results?</description>
      </k>
      <k value="5">
        <target>&gt;= 0.80</target>
        <description>Did any gold passage appear in top 5 results?</description>
      </k>
    </recall_at_k>

    <mean_reciprocal_rank_at_5>
      <target>&gt;= 0.65</target>
      <description>Rank of first correct result (1/rank, averaged)</description>
      <formula>MRR = (1/|Q|) * Σ(1/rank_i) for first relevant result</formula>
    </mean_reciprocal_rank_at_5>

    <entity_hit_rate>
      <target>&gt;= 0.85</target>
      <description>Percentage of queries with any shared entity in top-5 results</description>
      <evaluation>Compare entities in gold queries vs retrieved sections</evaluation>
    </entity_hit_rate>

    <domain_match_rate>
      <target>&gt;= 0.85</target>
      <description>Top-1 domain matches gold domain</description>
      <evaluation>Check if retrieved section domain matches query domain</evaluation>
    </domain_match_rate>

    <latency_metrics>
      <p50_target_ms>80</p50_target_ms>
      <p95_target_ms>150</p95_target_ms>
      <description>End-to-end /retrieve response time</description>
      <breakdown_tracking>
        <component>embedding_time</component>
        <component>ann_search_time</component>
        <component>reranking_time</component>
        <component>graph_boost_time</component>
      </breakdown_tracking>
    </latency_metrics>

    <context_budget_adherence>
      <target>100%</target>
      <description>Percentage of responses within token budget</description>
      <max_tokens>4096</max_tokens>
      <evaluation>Ensure trimming doesn't cut essential facts</evaluation>
    </context_budget_adherence>

    <reranker_gain>
      <delta_mrr_target>&gt;= +0.05</delta_mrr_target>
      <delta_recall_at_5_target>&gt;= +0.02</delta_recall_at_5_target>
      <description>Improvement vs ANN-only baseline</description>
      <comparison>With reranker vs without reranker</comparison>
    </reranker_gain>

    <graph_boost_gain>
      <delta_recall_at_5_target>&gt;= +0.02</delta_recall_at_5_target>
      <description>Improvement when graph boost is enabled</description>
      <comparison>With 1-hop graph vs without graph</comparison>
    </graph_boost_gain>
  </metrics>

  <execution>
    <batch_size>10</batch_size>
    <max_concurrent_requests>5</max_concurrent_requests>
    <timeout_seconds>30</timeout_seconds>
    <retry_attempts>3</retry_attempts>
    <delay_between_requests_ms>100</delay_between_requests_ms>

    <output>
      <results_file>evaluation_results.json</results_file>
      <detailed_report>evaluation_report.md</detailed_report>
      <plots_directory>evaluation_plots/</plots_directory>
      <include_confusion_matrices>true</include_confusion_matrices>
      <include_latency_distributions>true</include_latency_distributions>
    </output>

    <logging>
      <level>INFO</level>
      <log_file>evaluation.log</log_file>
      <track_failures>true</track_failures>
    </logging>
  </execution>

  <domain_targets>
