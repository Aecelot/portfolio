      <recall_at_1>0.72</recall_at_1>
      <recall_at_3>0.78</recall_at_3>
      <recall_at_5>0.82</recall_at_5>
      <mrr_at_5>0.68</mrr_at_5>
      <entity_hit_rate>0.87</entity_hit_rate>
      <domain_match_rate>0.88</domain_match_rate>
      <latency_p50_ms>45</latency_p50_ms>
      <latency_p95_ms>120</latency_p95_ms>
      <reranker_gain_mrr>0.08</reranker_gain_mrr>
      <graph_boost_gain>0.03</graph_boost_gain>
    </summary_metrics>
    <failure_analysis><![CDATA[
- Queries with zero recall (critical failures)
- Domain mismatches (classifier issues)
- High-latency queries (performance problems)
- Entity linking failures (alias resolution issues)
]]></failure_analysis>
  </expected_outputs>
</evaluation>